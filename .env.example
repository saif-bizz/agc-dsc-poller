# Copy to .env (gitignored) for LOCAL DEV ONLY. Do not commit real values.
# In production, all of these are set as GitHub repository secrets.

# --- Gallabox (WhatsApp BSP) ---
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_ACCOUNT_ID=
GALLABOX_CHANNEL_ID=
GALLABOX_API_BASE=https://server.gallabox.com/devapi

# --- Shopify ---
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REVIEW_CHAT_ID=

# --- Cloudflare KV (audit log) ---
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=

# --- Floor-team escalation user (Gallabox userId) ---
ESCALATION_USER_ID=

# --- AOV escalation threshold (numeric, currency units; e.g. 2000) ---
# Above this order-value, Sara hands off to floor team.
ESCALATION_AOV_THRESHOLD=

# --- Runtime flags ---
DRY_RUN=true
MAX_THREADS_PER_TICK=10

# --- Claude Code OAuth (set as GitHub secret only; not used locally) ---
# CLAUDE_CODE_OAUTH_TOKEN=
